{
  "name": "쿠팡 무료자동화 — 노션 저장 버전",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 6 * * *" } ] }
      },
      "id": "node-cron",
      "name": "매일 06:00 트리거",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-80, 300]
    },
    {
      "parameters": {
        "jsCode": "const MAX = 3;\nconst keywords = ['홈오피스 생산성', '재택 가젯', 'AI 자동화 소품'];\nconst kw = keywords[(new Date().getDate()) % keywords.length];\nreturn [{ json: { keyword: kw, max: MAX } }];"
      },
      "id": "node-config",
      "name": "일일 한도 설정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/search",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "Bearer {{$env.FIRECRAWL_API_KEY}}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{$json.keyword}} 리뷰 사양\",\n  \"limit\": {{$json.max}}\n}",
        "options": {}
      },
      "id": "node-crawl",
      "name": "Firecrawl 리서치(무료 한도)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "const max = $('일일 한도 설정').first().json.max;\nconst data = items[0].json.data || items[0].json.results || [];\nreturn data.slice(0, max).map((r) => ({ json: {\n  title: r.title || r.metadata?.title || '',\n  url: r.url || '',\n  summary: (r.markdown || r.description || '').slice(0, 1500)\n} }));"
      },
      "id": "node-limit",
      "name": "한도 적용 + 사양만 추출",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{ \"parts\": [{ \"text\": \"너는 @ai_ang2 브랜드 보이스(친근한 존댓말, 쉬운 말, 과장·낚시 금지)의 카피라이터다. 아래 상품 정보로 쿠팡 상세페이지용 한국어 카피를 써라. 구성: 후킹 한 줄 / 이런 분께 추천 3개 / 핵심 장점 3개 / 아쉬운 점 1개 / 총평. 효능 과장 금지, 가격·재고는 [확인 필요]로. 마지막 줄에 반드시 '이 포스팅은 쿠팡파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.' 추가.\\n\\n[상품정보]\\n제목: {{$json.title}}\\n요약: {{$json.summary}}\" }] }]\n}",
        "options": {}
      },
      "id": "node-copy",
      "name": "Gemini 상세페이지 카피(무료)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "const disclosure = '이 포스팅은 쿠팡파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.';\nconst src = $('한도 적용 + 사양만 추출').all();\nreturn items.map((it, i) => {\n  let copy = it.json?.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  if (!copy.includes('쿠팡파트너스 활동')) copy += '\\n\\n' + disclosure;\n  return { json: {\n    title: src[i]?.json.title || '',\n    refUrl: src[i]?.json.url || '',\n    coupangLink: '{쿠팡링크 — 쿠팡 검색 후 파트너스 딥링크로 교체}',\n    detailPageCopy: copy,\n    status: 'DRAFT'\n  } };\n});"
      },
      "id": "node-assemble",
      "name": "초안 조립(+쿠팡링크 자리)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": { "__rl": true, "value": "YOUR_NOTION_DATABASE_ID", "mode": "id" },
        "title": "={{$json.title}}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "상태|select", "selectValue": "DRAFT" },
            { "key": "참고링크|url", "urlValue": "={{$json.refUrl}}" },
            { "key": "쿠팡링크|rich_text", "textContent": "={{$json.coupangLink}}" }
          ]
        },
        "blockUi": {
          "blockValues": [
            { "type": "paragraph", "textContent": "={{$json.detailPageCopy}}" }
          ]
        },
        "options": {}
      },
      "id": "node-notion",
      "name": "노션 DB에 초안 저장",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1360, 300],
      "credentials": { "notionApi": { "id": "REPLACE_WITH_CRED_ID", "name": "Notion account" } }
    }
  ],
  "connections": {
    "매일 06:00 트리거": { "main": [[{ "node": "일일 한도 설정", "type": "main", "index": 0 }]] },
    "일일 한도 설정": { "main": [[{ "node": "Firecrawl 리서치(무료 한도)", "type": "main", "index": 0 }]] },
    "Firecrawl 리서치(무료 한도)": { "main": [[{ "node": "한도 적용 + 사양만 추출", "type": "main", "index": 0 }]] },
    "한도 적용 + 사양만 추출": { "main": [[{ "node": "Gemini 상세페이지 카피(무료)", "type": "main", "index": 0 }]] },
    "Gemini 상세페이지 카피(무료)": { "main": [[{ "node": "초안 조립(+쿠팡링크 자리)", "type": "main", "index": 0 }]] },
    "초안 조립(+쿠팡링크 자리)": { "main": [[{ "node": "노션 DB에 초안 저장", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templatecredit": "cavybot" }
}
