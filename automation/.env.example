# 무료 한도 자동화에 필요한 키. 이 파일을 복사해 .env 로 만들고 채우세요.
# ⚠️ .env 는 절대 깃에 커밋하지 마세요(.gitignore 에 포함됨).

# --- 크롤링 (둘 중 하나만, 무료/카드X) ---
FIRECRAWL_API_KEY=          # https://www.firecrawl.dev (무료 1,000크레딧/월)
APIFY_TOKEN=                # https://console.apify.com (무료 $5/월) — Firecrawl 대신 쓸 때

# --- 카피/요약 생성 (무료/카드X) ---
GEMINI_API_KEY=             # https://aistudio.google.com (Google AI Studio, 무료)

# --- 제휴 (필수) ---
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=

# --- (선택) 영상/이미지 API: 무료 크레딧 소진 후 카드 필요할 수 있어 기본은 미사용 ---
# FAL_KEY=
# REPLICATE_API_TOKEN=
